# ============================================================
# Code Analyzer — Environment Configuration
# ============================================================

# LLM Provider: "anthropic" | "groq" | "openai" | "grok" | "gemini"
LLM_PROVIDER=cohere

COHERE_API_KEY=your_cohere_key_here
COHERE_MODEL=command-r-plus-08-2024

#GROQ_API_KEY=
#GROQ_MODEL=gemma2-9b-it

# ── Anthropic via AgentRouter (free credits) ───────────────
# Your key from: https://agentrouter.org/console/token
#ANTHROPIC_API_KEY=sk-1bLKrJjq2ioyk5xyMYgbvITt2BvyKinG5PFuNEXSpVpguIgO
## AgentRouter base URL (proxies to Anthropic)
#ANTHROPIC_BASE_URL=https://agentrouter.org
## Model to use
#ANTHROPIC_MODEL=claude-opus-4-5

# ── Direct Anthropic (official) ────────────────────────────
# Comment out ANTHROPIC_BASE_URL above and use this instead:
#ANTHROPIC_API_KEY=sk-ant-your-real-key-here
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#ANTHROPIC_MODEL=claude-opus-4-5

# ── Groq (free tier) ───────────────────────────────────────
#LLM_PROVIDER=groq
#GROQ_API_KEY=gsk_your-groq-key-here
#GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI ─────────────────────────────────────────────────
#LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-your-openai-key-here
#OPENAI_MODEL=gpt-4o

# ── Analysis Limits ────────────────────────────────────────
# How many source files to send to LLM total
MAX_FILES_FOR_LLM=30
# How many files per LLM batch call
BATCH_SIZE=5
# Max characters read per file
MAX_CHARS_PER_FILE=3000
MAX_ZIP_SIZE_MB=500
LLM_TIMEOUT_SECONDS=180

# ── CORS & Server ──────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*
SERVER_PORT=8080

